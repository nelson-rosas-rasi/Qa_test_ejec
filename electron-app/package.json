{
  "name": "runqa",
  "version": "1.5.1",
  "description": "RunQA — ejecuta pruebas Playwright, se actualiza solo y genera reportes Word vía n8n.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "node scripts/check-release-config.js && electron-builder --publish always",
    "test": "node --test \"test/*.test.js\""
  },
  "author": "",
  "license": "UNLICENSED",
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tuempresa.qatestrunner",
    "productName": "RunQA",
    "publish": {
      "provider": "github",
      "owner": "nelson-rosas-rasi",
      "repo": "Qa_test_ejec"
    },
    "win": {
      "target": "nsis-web",
      "icon": "renderer/assets/runqa-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RunQA",
      "runAfterFinish": true,
      "installerIcon": "renderer/assets/runqa-icon.ico",
      "uninstallerIcon": "renderer/assets/runqa-icon.ico",
      "uninstallDisplayName": "RunQA ${version}"
    },
    "nsisWeb": {
      "artifactName": "RunQA Installer ${version}.${ext}"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/assets/runqa-icon.png"
    },
    "asarUnpack": [
      "main/playwright/ndjson-reporter.cjs"
    ],
    "files": [
      "main.js",
      "preload.js",
      "main/**/*",
      "renderer/**/*",
      "mock/**/*"
    ]
  }
}
